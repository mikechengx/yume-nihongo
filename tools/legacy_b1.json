   "grammar": [
    {
     "p": "〜は〜です",
     "c": "",
     "m": "",
     "d": "判断句“A 是 B”。は在这里读作 wa，用来提出话题；です表示礼貌的断定。",
     "ex": [
      [
       "私は学生です。",
       "我是学生。"
      ],
      [
       "田中さんは会社員です。",
       "田中先生是公司职员。"
      ]
     ],
     "note": "",
     "cmp": "",
     "lv": "N5"
    },
    {
     "p": "〜は〜ではありません",
     "c": "",
     "m": "",
     "d": "“A 不是 B”，是です的否定。口语里也常说〜じゃありません。",
     "ex": [
      [
       "私は先生ではありません。",
       "我不是老师。"
      ],
      [
       "李さんは日本人じゃありません。",
       "小李不是日本人。"
      ]
     ],
     "note": "",
     "cmp": "",
     "lv": "N5"
    },
    {
     "p": "〜は〜ですか",
     "c": "",
     "m": "",
     "d": "句尾加か就成了疑问句，语调上扬。回答用「はい、そうです」或「いいえ、違います」。",
     "ex": [
      [
       "あなたは留学生ですか。",
       "你是留学生吗？"
      ],
      [
       "はい、そうです。",
       "是的。"
      ]
     ],
     "note": "",
     "cmp": "",
     "lv": "N5"
    },
    {
     "p": "名词の名词",
     "c": "",
     "m": "",
     "d": "の连接两个名词，表示所属或性质，相当于“的”。",
     "ex": [
      [
       "私は北京大学の学生です。",
       "我是北京大学的学生。"
      ],
      [
       "これは私の名前です。",
       "这是我的名字。"
      ]
